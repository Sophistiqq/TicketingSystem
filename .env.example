# Copy to .env and set a long, random JWT secret before starting Compose.
JWT_SECRET=
TZ=Asia/Manila

# Browser-facing URLs. For LAN/domain access replace localhost in BOTH values.
FRONTEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:3002

# Optional Web Push configuration. Generate your own key pair (see README).
VAPID_CONTACT=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
