{
  "name": "ticketing-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build && bun build scripts/migrate.ts --target=bun --outfile build/migrate.js",
    "start": "bun build/migrate.js && bun build/index.js",
    "db:migrate": "bun scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "preview": "bun --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
    "test": "bun test",
    "test:server": "bun scripts/check-remotes.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "~7.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "^24.12.0",
    "daisyui": "^5.0.0",
    "devalue": "5.9.4",
    "drizzle-kit": "0.31.11",
    "svelte": "~5.57.3",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "vite": "~8.3.6"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/aleo": "^5.2.7",
    "@fontsource/teko": "^5.2.7",
    "@fontsource/ubuntu": "^5.2.8",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-bubble-menu": "^3.22.4",
    "@tiptap/extension-table": "^3.22.4",
    "@tiptap/extension-table-cell": "^3.22.4",
    "@tiptap/extension-table-header": "^3.22.4",
    "@tiptap/extension-table-row": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "chart.js": "^4.5.1",
    "driver.js": "^1.4.0",
    "drizzle-orm": "0.45.4",
    "elysia": "^1.4.28",
    "jose": "6.2.15",
    "lucide-svelte": "^1.0.1",
    "theme-change": "^2.5.0",
    "zod": "4.6.7"
  }
}
